# Environment Mode ("development" | "production" | "test")
NODE_ENV="development"

# Server Port
PORT=3000

# GEMINI_API_KEY: Required for Gemini AI API calls (AI Tutor, Notes, Quizzes, Study Plans, RAG Embeddings).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# AI_API_KEY: Optional alias for GEMINI_API_KEY when deploying standalone
AI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# CORS & URL Configuration
# In production, set CLIENT_URL to your deployed frontend origin (comma-separated if multiple)
CLIENT_URL="http://localhost:3000"
SERVER_URL="http://localhost:3000"

# Database Configuration
# Provide a MongoDB Atlas or local MongoDB URI.
# When omitted in preview/development, the server automatically uses a persistent local JSON-backed MongoDB adapter.
MONGODB_URI="mongodb+srv://<username>:<password>@cluster0.mongodb.net/lumina_scholar?retryWrites=true&w=majority"

# Authentication Configuration
JWT_SECRET="replace_with_a_strong_64_char_random_jwt_secret_in_production"
JWT_EXPIRES_IN="7d"


